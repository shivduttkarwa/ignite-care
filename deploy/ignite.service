[Unit]
Description=Ignite portal API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ignite
Group=ignite
WorkingDirectory=/srv/ignite/app
RuntimeDirectory=ignite
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/srv/ignite/app/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/ignite/gunicorn.sock \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
